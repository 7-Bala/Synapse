# ------------------------------------------------------------------------------
.idea/
*.iws
*.iml
*.ipr
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.fleet/

# ------------------------------------------------------------------------------
# 3. Python
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
.env
.env.*
!.env.example
venv.bak/
env.bak/

# Testing / Type Checking
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
*.cover
*.py,cover
.hypothesis/
.tox/
nosetests.xml

# ------------------------------------------------------------------------------
# 4. Node & Web Frontend (Vite)
# ------------------------------------------------------------------------------
node_modules/
jspm_packages/
web_modules/
.npm
.yarn/
.eslintcache
.stylelintcache

# Build outputs
frontend/dist/
frontend/build/
dist-ssr/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 5. Logs & Caches
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
